# ─────────────────────────────────────────────────────────────
# Cloudline Media — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used in emails, calendar links, webhooks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (database + admin auth) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=

# ── Square (deposit payments) ────────────────────────────────
# "sandbox" for testing, "production" when live
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Server only
SQUARE_ACCESS_TOKEN=
# From Square Developer Dashboard → Webhooks → your subscription
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the webhook URL registered in Square EXACTLY
SQUARE_WEBHOOK_URL=https://YOUR-DOMAIN/api/webhooks/square

# ── Resend (transactional email) ─────────────────────────────
RESEND_API_KEY=
# Must be a verified domain sender in Resend, e.g. "Cloudline Media <bookings@cloudlinemedia.com>"
EMAIL_FROM=
# Where internal booking / contact notifications go (comma-separated)
TEAM_NOTIFICATION_EMAILS=
# Optional reply-to address for customer emails
EMAIL_REPLY_TO=

# ── Google (optional) ────────────────────────────────────────
# Browser key restricted to your domain, with "Maps JavaScript API" + "Places API (New)" enabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: block times that are busy on a Google Calendar and add confirmed shoots to it.
# Create a service account, share the calendar with its email ("Make changes to events").
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Meta (Facebook / Instagram ads) ──────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
# Optional: Conversions API (server-side Purchase events, deduplicated with the Pixel)
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events code (remove in production)
META_CAPI_TEST_EVENT_CODE=

# ── Spam protection (optional) ───────────────────────────────
# Cloudflare Turnstile. If unset, the contact form uses honeypot + timing + rate limits only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cron ─────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" for /api/cron/maintenance
CRON_SECRET=
# Salt for hashing IP addresses (rate limiting). Any long random string.
IP_HASH_SALT=
